{
  "uid": "opson-users",
  "title": "Opson \u00b7 Users",
  "description": "Who is using Opson, and how. Population, new and returning people, modes, platforms and builds, and the roster: click a user id to open everything about that person on User detail.\n\nReads the `support` views (V22): one row per person, counts and choices only, never what anyone logged. No email appears on this board; User detail is the one board that shows it. Postgres panels are durable; the two Loki panels cannot see past 31 days.",
  "tags": [
    "opson"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod : opson-prod-db,dev : opson-db",
        "current": {
          "text": "prod",
          "value": "opson-prod-db",
          "selected": true
        },
        "options": [
          {
            "text": "prod",
            "value": "opson-prod-db",
            "selected": true
          },
          {
            "text": "dev",
            "value": "opson-db",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Pulse",
      "type": "link",
      "url": "/d/opson-pulse/opson-pulse?var-env=${env}",
      "tooltip": "",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Population",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Accounts",
      "description": "Every account, all time.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM support.users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Claimed",
      "description": "Accounts with an email, Google or Apple sign-in.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM support.users WHERE NOT is_guest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Guests",
      "description": "Accounts that live on one phone until claimed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM support.users WHERE is_guest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "New in range",
      "description": "Accounts created in the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM support.users WHERE $__timeFilter(joined_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Logged in the last 7 days",
      "description": "People with an entry dated in the last week.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT user_id) FROM support.user_daily_logging WHERE day > current_date - 7"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Never logged",
      "description": "Accounts with no entries. Onboarded and left, or just arrived.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM support.users WHERE entries = 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 7,
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "New and returning loggers",
      "description": "People who logged each day: new is their first logged day ever, returning is any later one.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT d.day::timestamp AS time, count(*) FILTER (WHERE d.day = u.first_log_day) AS \"new\", count(*) FILTER (WHERE d.day > u.first_log_day) AS \"returning\" FROM support.user_daily_logging d JOIN support.users u USING (user_id) WHERE $__timeFilter(d.day::timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Accounts created per day",
      "description": "New accounts by day, split by whether they are claimed now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', joined_at) AS time, count(*) FILTER (WHERE is_guest) AS \"guest\", count(*) FILTER (WHERE NOT is_guest) AS \"claimed\" FROM support.users WHERE $__timeFilter(joined_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Modes, platforms and builds",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "piechart",
      "title": "Mode",
      "description": "The visibility mode each account runs now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(preset, 'not synced yet') AS metric, count(*) AS value FROM support.users GROUP BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "piechart",
      "title": "Platform",
      "description": "The platform of each account's most recent install. 'Not seen' accounts have made no signed-in request since the 0.2 server began recording builds.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(platform, 'not seen by the server') AS metric, count(*) AS value FROM support.users GROUP BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "id": 12,
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Builds in use",
      "description": "The build each account's latest install runs. Read this before raising the version floor.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT platform, app_version AS version, build_number AS build, count(*) AS people, max(last_seen_at) AS last_seen FROM support.users WHERE app_version IS NOT NULL GROUP BY 1, 2, 3 ORDER BY people DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no builds recorded yet"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 13,
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Installs active by platform",
      "description": "Distinct installs that opened the app, per interval, by platform. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "count by (platform) (sum by (platform, install_id) (count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"app.foregrounded\" [$__interval])))",
          "legendFormat": "{{platform}}",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No client telemetry in this range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1d",
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Builds seen in telemetry",
      "description": "Installs by platform and app version that opened the app in the range. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "count by (platform, service_version) (sum by (platform, service_version, install_id) (count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"app.foregrounded\" [$__range])))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No client telemetry in this range"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Roster",
      "collapsed": false,
      "panels": [],
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "People",
      "description": "Everyone, most recently seen first. Click a user id for User detail. Counts only: this board cannot show what anyone logged.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT user_id::text AS user_id, coalesce(display_name, '') AS name, CASE WHEN is_guest THEN 'guest' ELSE 'claimed' END AS account, joined_at AS joined, last_seen_at AS last_seen, coalesce(platform, '') AS platform, coalesce(app_version, '') AS version, coalesce(preset, '') AS mode, days_logged, entries, last_log_day FROM support.users ORDER BY coalesce(last_seen_at, joined_at) DESC NULLS LAST LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "user_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "User detail",
                    "url": "/d/opson-user/opson-user-detail?var-env=${env}&var-user=${__value.raw}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 14
      }
    }
  ]
}
