{
  "uid": "opson-pulse",
  "title": "Opson Pulse",
  "description": "Is the app healthy, and is anyone using it? Start here. Row 1 is the glance: if it is all green or plain, close the tab.\n\nPostgres panels are durable at any range. Loki panels cannot see past 31 days, and read nothing at all while no build carries the Grafana OTLP credentials: the first stat says so.",
  "tags": [
    "opson"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod : opson-prod-db,dev : opson-db",
        "current": {
          "text": "prod",
          "value": "opson-prod-db",
          "selected": true
        },
        "options": [
          {
            "text": "prod",
            "value": "opson-prod-db",
            "selected": true
          },
          {
            "text": "dev",
            "value": "opson-db",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Users",
      "type": "link",
      "url": "/d/opson-users/opson-c2b7-users?var-env=${env}",
      "tooltip": "",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "The glance",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Client telemetry, last 24h",
      "description": "Every record the app shipped to Loki in the last day. 0 means no build is exporting: the GRAFANA_* secrets are missing from the release build, or nobody opened the app. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} [24h]))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Crash-free launches",
      "description": "Launches whose previous run did not crash or run out of memory, from `previous_exit` on `app.launched`. Android only in practice: iOS reports `unknown` until MetricKit delivers, which flatters the number. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"app.launched\" | previous_exit=~\"crash|oom\" [$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"app.launched\" [$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "1 - ($A / $B)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.98
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "noValue": "no launches"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
