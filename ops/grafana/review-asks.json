    {
      "type": "timeseries",
      "title": "Asks per day by moment",
      "description": "Set this against the store's daily ratings. A rise in ratings a day or two after a moment's asks is the signal; with every moment running at once it cannot be told apart. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (variant) (count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"review.asked\" | experiment!=\"qa\" [1d]))",
          "legendFormat": "{{variant}}",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No client telemetry in this range"
        },
        "overrides": []
      },
      "options": {
