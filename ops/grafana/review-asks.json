{
  "uid": "opson-review-asks",
  "title": "Opson \u00b7 Review asks",
  "description": "Which happy moment to ask for a store rating at. Asks per moment over time, to set against the store's ratings by date. The stores never say who rated.",
  "tags": [
    "opson"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod : opson-prod-db,dev : opson-db",
        "current": {
          "text": "prod",
          "value": "opson-prod-db",
          "selected": true
        },
        "options": [
          {
            "text": "prod",
            "value": "opson-prod-db",
            "selected": true
          },
          {
            "text": "dev",
            "value": "opson-db",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Pulse",
      "type": "link",
      "url": "/d/opson-pulse/opson-pulse?var-env=${env}",
      "tooltip": "",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "options": {
        "mode": "markdown",
        "content": "Each install asks at one moment (its **variant**), split by the `review.weight*` values in remote config. Neither store says whether anyone rated, so this board counts **asks**, and whether the sheet was **likely shown**, by moment and day. The outcome is the store's own numbers: App Store Connect \u203a Ratings and Reviews and Play Console \u203a Ratings, by date. To credit a change in ratings to one moment, run one moment at a time (all other weights 0, a new `review.experiment` name) for two weeks each. Full method in `docs/practices/review-asks.md`."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "Asks",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Asks",
      "description": "Times the store was asked for its sheet. QA menu asks are left out. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"review.asked\" | experiment!=\"qa\" [$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Likely shown",
      "description": "Asks where the sheet probably appeared: a new window on iOS, a flow that stayed up on Android. Loki keeps 31 days, so this panel cannot look further back.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"review.asked\" | experiment!=\"qa\" | outcome=\"likely_shown\" [$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
