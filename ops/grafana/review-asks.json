        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Installs asked",
      "description": "Distinct installs asked at least once. Asks are 122 days apart, so this is close to Asks. Loki keeps 31 days, so this panel cannot look further back.",
