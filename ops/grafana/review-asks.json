            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "count(sum by (install_id) (count_over_time({service_name=\"opson-client\", deployment_environment=\"${env:text}\"} | event_name=\"review.asked\" | experiment!=\"qa\" [$__range])))",
          "legendFormat": "",
