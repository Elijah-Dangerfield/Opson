{
  "uid": "opson-foods",
  "title": "Opson \u00b7 Food catalog",
  "description": "Is the food database good enough? Zero-result searches are the to-do list.",
  "tags": [
    "opson"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod : opson-prod-db,dev : opson-db",
        "current": {
          "text": "prod",
          "value": "opson-prod-db",
          "selected": true
        },
        "options": [
          {
            "text": "prod",
            "value": "opson-prod-db",
            "selected": true
          },
          {
            "text": "dev",
            "value": "opson-db",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Searches per day",
      "description": "Searches, and the ones that returned no foods.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, searches, zero_result_searches AS \"found nothing\" FROM analytics.search_daily WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Zero-result rate",
      "description": "Share of searches that found nothing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, zero_result_rate AS \"rate\" FROM analytics.search_daily WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Top searches that found nothing",
      "description": "Last 30 days, queries searched at least three times. Add these foods or synonyms first.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT * FROM analytics.top_zero_result_queries"
        }
      ],
      "fieldConfig": {
        "defaults": {},
