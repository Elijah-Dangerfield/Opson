    },
    {
      "type": "barchart",
      "title": "Barcode misses by country",
      "description": "The phone's region setting at the time of the miss. Tells us which country's data to add next.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT country, sum(misses) AS misses FROM analytics.barcode_misses_by_country WHERE $__timeFilter(day::timestamp) GROUP BY country ORDER BY misses DESC LIMIT 20"
        }
