              "datasourceUid": "opson-prod-db",
              "model": {
                "refId": "A",
                "rawSql": "SELECT coalesce(sum(contributions), 0) AS value FROM analytics.contribution_flags_daily WHERE flag IN ('impossible_value', 'kcal_zero_with_macros') AND day = current_date",
                "rawQuery": true,
                "editorMode": "code",
                "format": "table"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
