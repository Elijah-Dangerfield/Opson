          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "annotations": {
            "summary": "More than 10 submissions today hold an impossible amount or 0 kcal beside macros.",
            "__dashboardUid__": "opson-builders"
          },
          "labels": {
            "app": "opson",
            "board": "builders"
          },
          "isPaused": false
        },
        {
          "uid": "opson-builders-queue-age",
          "title": "Review queue ageing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
