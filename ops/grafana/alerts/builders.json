{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "opson-builders",
      "folder": "Opson",
      "interval": "5m",
      "rules": [
        {
          "uid": "opson-builders-burst",
          "title": "One contributor, many submissions in an hour",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "opson-prod-db",
              "model": {
                "refId": "A",
                "rawSql": "SELECT count(*) AS value FROM support.contributors WHERE submitted_1h > 15",
                "rawQuery": true,
                "editorMode": "code",
                "format": "table"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "annotations": {
            "summary": "Someone sent more than 15 foods in the last hour. Scripted, or farming for Pro: open Contributors to look at.",
            "__dashboardUid__": "opson-builders"
          },
          "labels": {
            "app": "opson",
            "board": "builders"
          },
          "isPaused": false
        },
        {
          "uid": "opson-builders-flags",
          "title": "One contributor, many flags in a day",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "opson-prod-db",
              "model": {
                "refId": "A",
                "rawSql": "SELECT count(*) AS value FROM support.contributors WHERE flagged_24h >= 5 AND standing = 'ok'",
                "rawQuery": true,
                "editorMode": "code",
                "format": "table"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "annotations": {
            "summary": "A contributor in good standing had five or more flagged submissions in 24 hours.",
            "__dashboardUid__": "opson-builders"
          },
          "labels": {
            "app": "opson",
            "board": "builders"
          },
          "isPaused": false
        },
        {
          "uid": "opson-builders-approval",
          "title": "Approval rate collapsed",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "opson-prod-db",
              "model": {
                "refId": "A",
                "rawSql": "SELECT CASE WHEN coalesce(sum(contributions) FILTER (WHERE state IN ('approved', 'rejected')), 0) < 20 THEN 1 ELSE sum(contributions) FILTER (WHERE state = 'approved')::float / sum(contributions) FILTER (WHERE state IN ('approved', 'rejected')) END AS value FROM analytics.contributions_daily WHERE kind = 'submission' AND day > current_date - 7",
                "rawQuery": true,
                "editorMode": "code",
                "format": "table"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1h",
          "annotations": {
            "summary": "Under half of the last 7 days' submissions (20 or more decided) were approved.",
            "__dashboardUid__": "opson-builders"
          },
          "labels": {
            "app": "opson",
            "board": "builders"
          },
          "isPaused": false
        },
        {
          "uid": "opson-builders-photo-reuse",
          "title": "Photo reused across accounts",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "opson-prod-db",
              "model": {
                "refId": "A",
                "rawSql": "SELECT count(*) AS value FROM support.photo_reuse WHERE cross_account AND created_at > now() - interval '1 hour'",
