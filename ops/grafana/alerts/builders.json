            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "annotations": {
            "summary": "Two accounts sent the same photo in the last hour. Almost always sock puppets.",
            "__dashboardUid__": "opson-builders"
          },
          "labels": {
            "app": "opson",
            "board": "builders"
          },
          "isPaused": false
        },
        {
          "uid": "opson-builders-impossible",
