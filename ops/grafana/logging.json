{
  "uid": "opson-logging",
  "title": "Opson \u00b7 Logging",
  "description": "How people add food: which methods, how precise, how many meals. Aggregates only.",
  "tags": [
    "opson"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod : opson-prod-db,dev : opson-db",
        "current": {
          "text": "prod",
          "value": "opson-prod-db",
          "selected": true
        },
        "options": [
          {
            "text": "prod",
            "value": "opson-prod-db",
            "selected": true
          },
          {
            "text": "dev",
            "value": "opson-db",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Entries by method",
      "description": "Search, saved meals, copy, describe, ate with no details, and so on.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, method AS metric, sum(entries) AS value FROM analytics.entries_by_method_precision WHERE $__timeFilter(day::timestamp) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "piechart",
      "title": "Precision mix",
      "description": "Weighed, estimated, or just the name. A healthy mix leans on estimates; it is not a goal to push toward weighing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT precision AS metric, sum(entries) AS value FROM analytics.entries_by_method_precision WHERE $__timeFilter(day::timestamp) GROUP BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "piechart",
      "title": "Method mix",
      "description": "Share of entries by how they were added, over the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT method AS metric, sum(entries) AS value FROM analytics.entries_by_method_precision WHERE $__timeFilter(day::timestamp) GROUP BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "'Ate, no details' share",
      "description": "Meals marked eaten without details. Rising means logging feels like too much work, or people are using the gentle path as intended.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamp AS time, sum(entries) FILTER (WHERE method = 'ate_no_details')::float / nullif(sum(entries), 0) AS \"share\" FROM analytics.entries_by_method_precision WHERE $__timeFilter(day::timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "barchart",
      "title": "Meals per logged day",
      "description": "How many meal slots have something in them on a day with any logging.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${env}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${env}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT meals_per_day::text AS meals, sum(person_days) AS days FROM analytics.meals_per_day_distribution WHERE $__timeFilter(day::timestamp) GROUP BY meals_per_day ORDER BY meals_per_day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
