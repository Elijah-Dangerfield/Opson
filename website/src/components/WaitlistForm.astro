---
import { API_URL, CONTACT_EMAIL } from '../consts';
import { waitlistEndpoint } from '../lib/waitlist';

interface Props {
  /** Anchor id, unique on the page. */
  id: string;
  /** Recorded as the source when the URL has no ?c= campaign. */
  page: string;
  /** Label for the email field. Screen readers say it; the placeholder shows it. */
  label?: string;
}

const { id, page, label = 'Your email' } = Astro.props;
---

<form
  class="waitlist"
  id={id}
  action={waitlistEndpoint(API_URL)}
  method="post"
  novalidate
  data-waitlist
  data-api={API_URL}
  data-page={page}
>
  <label class="visually-hidden" for={`${id}-email`}>{label}</label>
  <div class="row">
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      spellcheck="false"
      maxlength="254"
      required
      placeholder="Your email"
      aria-describedby={`${id}-status`}
    />
    <button class="button" type="submit">Join the waitlist</button>
  </div>
  <div class="visually-hidden" aria-hidden="true">
    <label for={`${id}-company`}>Company</label>
    <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="status" id={`${id}-status`} role="status" aria-live="polite" tabindex="-1"></p>
  <noscript>
    <p class="status">
      This form needs JavaScript. You can also email <a href={`mailto:${CONTACT_EMAIL}?subject=Waitlist`}>{CONTACT_EMAIL}</a> and we'll add you by hand.
    </p>
    <style>
      form[data-waitlist] .row { display: none; }
    </style>
  </noscript>
</form>

<script>
  import { MESSAGES, joinWaitlist, readSource } from '../lib/waitlist';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-waitlist]')) {
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const company = form.querySelector<HTMLInputElement>('input[name="company"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    let busy = false;

    const show = (state: keyof typeof MESSAGES) => {
      form.dataset.state = state;
      status.textContent = MESSAGES[state];
    };

    email.addEventListener('input', () => email.removeAttribute('aria-invalid'));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (busy) return;

      email.value = email.value.trim();
      if (!email.checkValidity()) {
        email.setAttribute('aria-invalid', 'true');
        show('invalid_email');
        email.focus();
        return;
      }
      email.removeAttribute('aria-invalid');

      busy = true;
      button.disabled = true;
      show('sending');
      const result = await joinWaitlist(form.dataset.api!, {
        email: email.value,
        source: readSource(location.search, form.dataset.page ?? ''),
        company: company.value,
      });
      busy = false;
      button.disabled = false;
      show(result);

      if (result === 'done') {
        email.value = '';
        // The row hides once you're on the list; keep focus somewhere sensible.
        status.focus();
      } else if (result === 'invalid_email') {
        email.setAttribute('aria-invalid', 'true');
        email.focus();
      }
    });
  }
</script>

<style>
  /* The form always sits on the dark band: the hero and the closing block. */
  .waitlist { width: 100%; max-width: 540px; margin-inline: auto; }
  .row { display: flex; gap: 10px; }
  input[type='email'] {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 56px;
    padding: 0 22px;
    font: 400 18px var(--font);
    color: var(--ink);
    background: var(--surface);
    border: 0;
    border-radius: var(--radius-pill);
  }
  input[type='email']::placeholder { color: var(--muted); opacity: 1; }
  input[type='email']:focus-visible { outline: 3px solid var(--cta); outline-offset: 2px; }
  input[aria-invalid='true'] { box-shadow: inset 0 0 0 2px var(--accent); }
  .button { min-height: 56px; flex: 0 0 auto; }
  .status {
    min-height: 1.5em;
    margin-top: 12px;
    color: var(--on-hero-soft);
    font-size: 16px;
  }
  .status:focus { outline: none; }
  .status a { color: var(--on-hero); }
  form[data-state='done'] .row { display: none; }
  form[data-state='done'] .status {
    margin-top: 0;
    font-weight: 800;
    font-size: 21px;
    color: var(--on-hero);
  }
  form[data-state='invalid_email'] .status,
  form[data-state='rate_limited'] .status,
  form[data-state='error'] .status {
    color: var(--on-hero);
    text-align: left;
    padding-left: 12px;
    border-left: 3px solid var(--cta);
  }
  @media (max-width: 560px) {
    .row { flex-direction: column; }
  }
</style>
