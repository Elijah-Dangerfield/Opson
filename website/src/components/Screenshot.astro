---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Widest the image is drawn, in CSS pixels. Sets the srcset and sizes. */
  width?: number;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, width = 320, class: className, loading = 'lazy' } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['webp']}
  fallbackFormat="webp"
  width={width * 2}
  widths={[width, width * 2]}
  sizes={`(max-width: 880px) 45vw, ${width}px`}
  quality={78}
  loading={loading}
  decoding="async"
  class:list={['shot', className]}
/>

<style>
  /* An iPhone screen's corner, as a share of its width and height. */
  :global(img.shot) {
    width: 100%;
    border-radius: 13% / 6%;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-raised);
    background: var(--surface);
  }
</style>
