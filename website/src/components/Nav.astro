---
import { href } from '../consts';
import { stripBase } from '../lib/paths';

const current = stripBase(import.meta.env.BASE_URL, Astro.url.pathname).replace(/\/?$/, '/');
const links = [
  { path: '/privacy/', label: 'Privacy' },
  { path: '/terms/', label: 'Terms' },
  { path: '/contact/', label: 'Contact' },
];
---

<header class="nav dark">
  <div class="wrap nav-inner">
    <a class="brand" href={href('/')} aria-current={current === '/' ? 'page' : undefined}>
      <img src={href('/opson-mark.svg')} alt="" width="40" height="40" />
      <span>Opson</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(({ path, label }) => (
          <li>
            <a href={href(path)} aria-current={current === path ? 'page' : undefined}>{label}</a>
          </li>
        ))}
        <li class="join"><a class="button" href={href('/#waitlist')}>Join the waitlist</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 23px;
    letter-spacing: -0.02em;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a:not(.button) {
    display: block;
    padding: 10px 12px;
    color: var(--on-hero-soft);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }
  ul a:not(.button):hover { color: var(--on-hero); }
  ul a[aria-current='page'] { color: var(--on-hero); box-shadow: inset 0 -3px 0 var(--cta); }
  .join { margin-left: 10px; }
  .join .button { min-height: 44px; padding: 0 20px; font-size: 16px; }

  @media (max-width: 720px) {
    .join { display: none; }
  }
  @media (max-width: 420px) {
    .nav-inner { min-height: 64px; }
    .brand { font-size: 20px; }
    .brand img { width: 34px; height: 34px; }
    ul a:not(.button) { padding: 8px 7px; font-size: 15px; }
  }
</style>
