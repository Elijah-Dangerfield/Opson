---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import Screenshot from '../components/Screenshot.astro';
import { href } from '../consts';

// The App Store screenshots, straight from docs/. Astro resizes them at build.
import todayFull from '../../../docs/app-store/screenshots/01-today-full.png';
import logger from '../../../docs/app-store/screenshots/02-logger-picked.png';
import todayBlind from '../../../docs/app-store/screenshots/03-today-blind.png';
import modes from '../../../docs/app-store/screenshots/04-modes.png';
import trends from '../../../docs/app-store/screenshots/05-trends-week.png';
// The Support screen from design v3, cropped in CSS to its two data buttons.
// The line above them in the design is out of date, so it stays out of frame.
import support from '../../../docs/design/v3/support.png';

// Only what 0.1 does. Barcode, photo and voice logging aren't in it yet.
const ways = [
  { name: 'Search', line: 'Find a food and pick how much.', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>' },
  { name: 'Describe it', line: 'Type what you ate in your own words.', icon: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>' },
  { name: 'Saved meals', line: 'Save a meal you eat often and add it again.', icon: '<path d="M6 3h12v18l-6-4-6 4z"/>' },
  { name: 'Copy yesterday', line: "Bring over yesterday's meal or the whole day.", icon: '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/>' },
  { name: 'Ate, no details', line: 'Mark that you ate without looking anything up.', icon: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>' },
];
---

<Layout>
  <section class="hero dark">
    <div class="wrap hero-inner">
      <h1><span>All the numbers,</span> <span>some of them,</span> <span>or none.</span></h1>
      <p class="lead">Opson is a food log where you decide how many numbers you see.</p>
      <WaitlistForm id="waitlist" page="home" />
      <p class="fine">
        One email when it's out, maybe a few updates before. Never sold or shared. <a href={href('/privacy/')}>Privacy</a>
      </p>
      <div class="hero-shot">
        <Screenshot
          src={todayFull}
          width={340}
          sizes="(max-width: 520px) 72vw, 340px"
          loading="eager"
          alt="Today in Full numbers: 739 kcal eaten against a range of 1,900 to 2,300, with protein, carbs and fat bars and a breakfast of oatmeal and a banana."
        />
      </div>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="why-title">Why Opson?</h2>
        <p>Here's what's in the first version.</p>
      </header>

      <div class="blocks">
        <article class="block breakfast">
          <div class="block-copy">
            <h3>Pick how many numbers you see</h3>
            <p>
              Full numbers shows everything, like a regular calorie counter. Blind takes calories out of the app
              completely. Eight more modes sit in between, and you can still change any single number after you
              pick one.
            </p>
          </div>
          <div class="block-media pair">
            <Screenshot
              src={todayBlind}
              width={250}
              sizes="(max-width: 880px) 40vw, 250px"
              alt="Today in Blind mode: no calories anywhere, just breakfast, lunch and snack ticked off and dinner around 7:00."
            />
            <Screenshot
              src={modes}
              width={250}
              sizes="(max-width: 880px) 40vw, 250px"
              alt="The Modes and numbers screen, listing ten starting points from Full numbers to Coast."
            />
          </div>
        </article>

        <article class="block lunch flip">
          <div class="block-copy">
            <h3>Logging is quick</h3>
            <p>
              Search for a food, copy yesterday's breakfast, or add a meal you saved. If you'd rather skip the
              details, just mark that you ate.
            </p>
          </div>
          <div class="block-media">
            <Screenshot
              src={logger}
              width={300}
              sizes="(max-width: 880px) 64vw, 300px"
              alt="Adding to a snack: a search for apple with 25 matches, Apple, raw picked, and 2 foods picked at the bottom."
            />
          </div>
        </article>

        <article class="block snack">
          <div class="block-copy">
            <h3>See your week without the nagging</h3>
            <p>
              Trends lines up each day against your range. There are no streaks and no “calories left” warnings.
              Skip a day and it's a gap in the chart, nothing more.
            </p>
          </div>
          <div class="block-media">
            <Screenshot
              src={trends}
              width={300}
              sizes="(max-width: 880px) 64vw, 300px"
              alt="Trends for a week: a bar for each day against a shaded range, with Wednesday left empty, and a recap of 6 of 7 days logged."
            />
          </div>
        </article>

        <article class="block dinner flip">
          <div class="block-copy">
            <h3>Your data stays yours</h3>
            <p>
              Your log is saved on your phone and synced to your account. You can export it as a CSV or delete
              everything from the app whenever you want. There are no ads, and nothing is sold or shared.
            </p>
          </div>
          <div class="block-media strip-media">
            <div class="strip">
              <Screenshot
                src={support}
                width={390}
                sizes="(max-width: 880px) 84vw, 420px"
                class="strip-shot"
                alt="Two buttons from the app's Support screen: Export everything (CSV) and Delete everything."
              />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="ways" aria-labelledby="ways-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="ways-title">Five ways to log</h2>
        <p>Use whichever fits the meal.</p>
      </header>
      <ul class="ways-list">
        {ways.map(({ name, line, icon }) => (
          <li>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </span>
            <span class="way-text">
              <strong>{name}</strong>
              <span>{line}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <div class="closing-block dark">
        <h2 id="closing-title">Want to know when it's out?</h2>
        <p>Opson is with Apple for review. Leave your email and we'll write when you can download it.</p>
        <WaitlistForm id="waitlist-bottom" page="home" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* How far the hero phone hangs below the dark band. */
  .hero, .why { --overlap: clamp(220px, 30vw, 330px); }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(48px, 8vw, 96px);
  }
  .hero h1 {
    font-size: clamp(36px, 7.4vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  /* Three lines, broken at the commas. */
  .hero h1 span { display: block; }
  .lead {
    margin: 22px 0 34px;
    max-width: 30em;
    font-size: clamp(18px, 2vw, 22px);
    color: var(--on-hero-soft);
  }
  .fine { margin-top: 2px; font-size: 15px; color: var(--on-hero-soft); }
  .hero-shot :global(picture) { display: block; }
  .hero-shot {
    position: relative;
    z-index: 1;
    width: min(340px, 72vw);
    margin: clamp(40px, 6vw, 64px) auto calc(-1 * var(--overlap));
  }

  .why { padding-top: calc(var(--overlap) + clamp(64px, 9vw, 112px)); }

  .section-head { text-align: center; margin-bottom: clamp(32px, 5vw, 56px); }
  .section-head h2 { color: var(--title); font-size: clamp(36px, 5vw, 56px); }
  .section-head p { margin-top: 12px; color: var(--ink-soft); font-size: clamp(18px, 2vw, 21px); }

  .blocks { display: flex; flex-direction: column; gap: clamp(20px, 3vw, 32px); }
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-radius: var(--radius-block);
    overflow: hidden;
    min-height: 460px;
  }
  .breakfast { background: var(--breakfast); color: var(--on-breakfast); }
  .lunch { background: var(--lunch); color: var(--on-lunch); }
  .snack { background: var(--snack); color: var(--on-snack); }
  .dinner { background: var(--dinner); color: var(--on-dinner); }

  .block-copy {
    align-self: center;
    padding: clamp(32px, 5vw, 72px);
  }
  .block h3 { font-size: clamp(30px, 3.6vw, 46px); }
  .block p { margin-top: 18px; font-size: clamp(17px, 1.6vw, 20px); max-width: 30em; }
  .flip .block-copy { order: 2; }

  /* The phone starts below the block's top edge and runs off the bottom, which
     crops it. */
  .block-media {
    align-self: end;
    display: flex;
    justify-content: center;
    gap: 20px;
    height: 420px;
    padding: 56px 32px 0;
    overflow: hidden;
  }
  .block-media :global(picture) { display: block; width: 300px; flex: 0 1 auto; }
  .pair :global(picture) { width: 250px; }
  .pair :global(picture:last-child) { margin-top: 36px; }

  .strip-media { align-self: center; align-items: center; height: auto; padding: 48px 40px; }
  .strip {
    width: 100%;
    max-width: 440px;
    aspect-ratio: 780 / 250;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-raised);
  }
  .strip-media .strip :global(picture) { display: block; width: 100%; height: 100%; }
  .strip :global(img.strip-shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 75%;
    border-radius: 0;
    box-shadow: none;
  }

  .ways { padding: clamp(80px, 11vw, 136px) 0 clamp(56px, 8vw, 96px); }
  .ways-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px 24px;
  }
  .ways-list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background: var(--accent-tint);
    color: var(--accent);
  }
  .way-text { display: flex; flex-direction: column; gap: 4px; }
  .way-text strong { font-size: 19px; color: var(--title); }
  .way-text span { color: var(--ink-soft); }

  .closing { padding-bottom: clamp(64px, 9vw, 112px); }
  .closing-block {
    border-radius: var(--radius-block);
    padding: clamp(44px, 7vw, 88px) clamp(20px, 5vw, 64px);
    text-align: center;
  }
  .closing h2 { font-size: clamp(34px, 5vw, 56px); }
  .closing p { margin: 16px auto 32px; max-width: 32em; color: var(--on-hero-soft); font-size: clamp(17px, 2vw, 20px); }

  @media (max-width: 960px) {
    .ways-list { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 640px; margin-inline: auto; }
    .ways-list li:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 880px) {
    .block { grid-template-columns: 1fr; min-height: 0; text-align: center; }
    .flip .block-copy { order: 0; }
    .block-copy { padding: 40px 24px 0; }
    .block p { margin-inline: auto; }
    .block-media { height: clamp(300px, 80vw, 420px); padding: 36px 20px 0; }
    .block-media :global(picture) { width: min(300px, 64vw); }
    .pair { gap: 14px; }
    .pair :global(picture) { width: min(250px, 40vw); }
    .pair :global(picture:last-child) { margin-top: 28px; }
    .strip-media { height: auto; padding: 32px 20px 40px; }
    .strip { margin-inline: auto; }
  }

  @media (max-width: 560px) {
    .ways-list { grid-template-columns: 1fr; gap: 22px; }
    .ways-list li { flex-direction: row; text-align: left; align-items: flex-start; }
    .icon { flex: 0 0 auto; width: 52px; height: 52px; }
  }
</style>
