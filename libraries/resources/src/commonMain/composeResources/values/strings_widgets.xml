<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy for home screen widgets (docs/plans/screens/widgets.md): the widget
  itself, the More row and the Widgets page. The More row and the Widgets page
  are behind release.widgets; the widget itself is in every build. Same
  rules as strings.xml: no backslash escapes, positional %1$s arguments. No
  string here takes a nutrition number: those come from the visibility policy.
  The only numbers passed in are counts of meals and glasses.
-->
<resources>

    <!-- The More row and the page title. Becomes v3's "Widgets and watch face" once the watch face ships. -->
    <string name="widgets_title">Widgets</string>
    <string name="widgets_intro">Widgets follow your mode, same as the app.</string>
    <string name="widgets_home_screen">Home screen</string>
    <string name="widgets_how_to_add">Touch and hold an empty spot on your home screen, then add Opson from the widget list.</string>

    <!-- On the widget. -->
    <string name="widgets_today">Today</string>
    <string name="widgets_log">Log food</string>
    <!-- What a screen reader says for a meal circle: "Breakfast, done". -->
    <string name="widgets_meal_done">%1$s, done</string>
    <string name="widgets_meal_not_yet">%1$s, not yet</string>
    <!-- With meal groups off there are no circles to show. -->
    <string name="widgets_note_log">Tap + to log</string>
    <string name="widgets_note_untracked">Not tracking today</string>

    <!-- The other widgets' titles. -->
    <string name="widgets_calories">Calories</string>
    <string name="widgets_macros">Macros</string>
    <string name="widgets_water">Water</string>
    <string name="widgets_meals">Meals</string>
    <string name="widgets_fasting">Fasting</string>
    <!-- Under what is left on the calories widget: "540" over "to range". Only in a mode that shows it. -->
    <string name="widgets_to_range">to range</string>
    <string name="widgets_to_goal">to goal</string>
    <!-- Meals done, the neutral figure: "2 of 4 meals". A count of meals, never a nutrition number. -->
    <string name="widgets_meals_done">%1$s of %2$s meals</string>
    <!-- The water widget's button. -->
    <string name="widgets_add_glass">Add a glass</string>
    <!-- What a screen reader says for softened water, which shows glasses and no amount. -->
    <string name="widgets_water_glasses">%1$s of %2$s glasses</string>
    <!-- A meal with nothing logged on the meals widget. -->
    <string name="widgets_nothing_yet">Nothing yet</string>
    <!-- The meals widget's one row with meal groups off. -->
    <string name="widgets_all_food">All food</string>
    <!-- When the mode keeps a widget's numbers in the app. -->
    <string name="widgets_macros_hidden">Your mode keeps macros in the app.</string>
    <string name="widgets_water_hidden">Your mode keeps water in the app.</string>
    <string name="widgets_fasting_off">The fasting timer is off.</string>
    <!-- The fasting widget's phases, and the line under each. %1$s is where the widget prints the
         time, in the phone's own clock style. -->
    <string name="widgets_fasting_now">Fasting</string>
    <string name="widgets_fasting_ends_at">Ends at %1$s</string>
    <string name="widgets_fasting_window">Eating window</string>
    <string name="widgets_fasting_until_at">Until %1$s</string>
    <string name="widgets_fasting_done">Fast done</string>
    <string name="widgets_fasting_next_at">Next fast at %1$s</string>
    <!-- A figure's amount and its unit on one line, "655 to range", "1,245 kcal", "82 g" -->
    <string name="widgets_amount_unit">%1$s %2$s</string>
    <!-- What a screen reader says for a macro on the macros widget: its name, then "82 / 120 g" -->
    <string name="widgets_macro_cd">%1$s, %2$s</string>
    <!-- What a screen reader says for the water widget's add button: "Add a glass", then "250 ml" -->
    <string name="widgets_add_glass_cd">%1$s, %2$s</string>

</resources>
