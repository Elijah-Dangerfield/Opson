<?xml version="1.0" encoding="utf-8"?>
<!--
  Celebrations (release.celebrations): the milestone screen, the streak on Today, Your progress,
  the line after wrapping up a day, and the Celebrations rows in More. They celebrate showing up,
  never eating less: no line here may mention food amounts, a goal or a deficit.
  Gentle lines are for someone who said numbers have been hard: no digits and no durations.
  Same rules as strings.xml: no backslash escapes, positional format specifiers.
-->
<resources>

    <!-- The celebration: the milestone in big type, then one honest line about what they did -->
    <string name="celebrate_first_wrap_up">Your first day, wrapped up</string>
    <string name="celebrate_days_3">3 days</string>
    <string name="celebrate_week_1">1 week</string>
    <string name="celebrate_weeks_2">2 weeks</string>
    <string name="celebrate_days_30">30 days</string>
    <string name="celebrate_days_100">100 days</string>
    <string name="celebrate_months_6">6 months</string>
    <string name="celebrate_year_1">1 year</string>
    <string name="celebrate_first_check_in">Your first check-in</string>
    <string name="celebrate_check_ins_7">7 check-ins</string>
    <string name="celebrate_check_ins_30">30 check-ins</string>
    <!-- Under a run's number -->
    <string name="celebrate_in_a_row">in a row</string>

    <string name="celebrate_first_wrap_up_line">You logged your day and wrapped it up. That's the whole habit, done once.</string>
    <string name="celebrate_days_3_line">Three days of showing up for yourself. Little and often is how this works.</string>
    <string name="celebrate_week_1_line">A full week of looking after yourself. You did that.</string>
    <string name="celebrate_weeks_2_line">Two weeks of coming back, day after day. This is becoming yours.</string>
    <string name="celebrate_days_30_line">A month of showing up for yourself. That takes real care.</string>
    <string name="celebrate_days_100_line">A hundred days, one at a time. Take a second to notice that.</string>
    <string name="celebrate_months_6_line">Half a year of looking after yourself. Look how far you've come.</string>
    <string name="celebrate_year_1_line">A whole year of showing up for yourself. That's something to be proud of.</string>
    <string name="celebrate_first_check_in_line">You stopped to notice how you feel. That's worth doing.</string>
    <string name="celebrate_check_ins_7_line">Seven times you've checked in with yourself. You're learning what your days feel like.</string>
    <string name="celebrate_check_ins_30_line">Thirty check-ins. You know your days better than you did.</string>

    <!-- Gentle: the same moments with a kind title and line, no counts -->
    <string name="celebrate_gentle_wrap_up">You wrapped up your day</string>
    <string name="celebrate_gentle_wrap_up_line">Taking a moment to look back is a kind thing to do.</string>
    <string name="celebrate_gentle_streak">You keep showing up</string>
    <string name="celebrate_gentle_days_3_line">Coming back is the whole thing, and you're doing it.</string>
    <string name="celebrate_gentle_week_1_line">Day after day, you've made a little time for yourself.</string>
    <string name="celebrate_gentle_weeks_2_line">This is starting to feel like yours.</string>
    <string name="celebrate_gentle_days_30_line">You've been looking after yourself for a while now. That takes care.</string>
    <string name="celebrate_gentle_days_100_line">Steady and kind, one day at a time.</string>
    <string name="celebrate_gentle_months_6_line">Look how far you've come, one ordinary day at a time.</string>
    <string name="celebrate_gentle_year_1_line">All those days add up to something. Take a moment with that.</string>
    <string name="celebrate_gentle_check_in">You checked in</string>
    <string name="celebrate_gentle_first_check_in_line">Noticing how you feel is worth doing.</string>
    <string name="celebrate_gentle_check_ins_7_line">You keep checking in with yourself. That's a good habit to have.</string>
    <string name="celebrate_gentle_check_ins_30_line">You know your days better than you did.</string>

    <!-- The buttons. The second shows on the very first celebration only. -->
    <string name="celebrate_can_do_this">I can do this</string>
    <string name="celebrate_rather_not">I'd rather not see these</string>
    <string name="celebrate_turned_off">Celebrations are off. Turn them back on in More.</string>

    <!-- The prompt, as the QA menu lists it -->
    <string name="celebrate_prompt_title">Milestone celebration</string>
    <string name="celebrate_prompt_body">A full-screen moment when someone reaches a milestone for showing up.</string>

    <!-- Day close, once the day is wrapped up, and the line after wrapping it up -->
    <plurals name="celebrate_run">
        <item quantity="one">%1$d day so far.</item>
        <item quantity="other">%1$d days in a row.</item>
    </plurals>
    <plurals name="celebrate_more_to">
        <item quantity="one">%1$d more to %2$s.</item>
        <item quantity="other">%1$d more to %2$s.</item>
    </plurals>
    <!-- Day close's run line: celebrate_run, then celebrate_more_to -->
    <string name="celebrate_run_with_next">%1$s %2$s</string>
    <string name="celebrate_gentle_run">You've been showing up. That counts.</string>
    <string name="celebrate_wrapped_toast">Day wrapped up. That's %1$d in a row.</string>
    <string name="celebrate_wrapped_toast_plain">Day wrapped up. See you tomorrow.</string>

