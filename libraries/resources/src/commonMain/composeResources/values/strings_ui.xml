<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy the design system components carry themselves (the ds_ keys in strings.xml are the
  older ones). Same rules as strings.xml: no backslash escapes, positional format specifiers.
-->
<resources>

    <!-- PageHeader: the back arrow's spoken label, with the page it goes back to -->
    <string name="ds_back_to">Back to %1$s</string>

    <!-- OpsonLockup: the wordmark, lowercase as the logo sets it -->
    <string name="ds_wordmark">opson</string>

    <!-- OpsonLoader on the boot screen: what a screen reader says while the app starts -->
    <string name="ds_loading">Loading</string>

    <!-- CyclingLoadingMessage: the captions under the boot loader when start-up runs long -->
    <string name="ds_loading_getting_ready">Getting things ready</string>
    <string name="ds_loading_your_data">Loading your data</string>
    <string name="ds_loading_almost_there">Almost there</string>

    <!-- BottomSheet: the grab handle's spoken action, which closes the sheet -->
    <string name="ds_sheet_close">Close</string>

</resources>
