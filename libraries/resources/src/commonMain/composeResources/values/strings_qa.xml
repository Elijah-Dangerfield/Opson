<?xml version="1.0" encoding="utf-8"?>
<!--
  The QA menu (More › Testing › QA menu), on debug and beta builds only. Testers read it,
  customers never do, so it is plain and technical rather than in the app's voice. The code that
  reads these is in :features:qa:impl, which store builds leave out.
  Same rules as strings.xml: no backslash escapes, positional format specifiers.
-->
