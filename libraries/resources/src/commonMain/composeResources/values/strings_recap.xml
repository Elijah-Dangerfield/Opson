<?xml version="1.0" encoding="utf-8"?>
<!--
  Weekly and monthly recaps (release.recaps): the recap screen, "Your week is ready" on Today and
  the way in from Trends. A recap says what happened and never grades it: no week is good or bad,
  nothing praises eating less. After numbers have been hard it says only how someone showed up
  and how they felt. Same rules as strings.xml: no backslash escapes, positional arguments.
-->
<resources>
    <string name="recap_title_week">Your week</string>
    <!-- %1$s is the month's name: "Your October" -->
    <string name="recap_title_month">Your %1$s</string>
