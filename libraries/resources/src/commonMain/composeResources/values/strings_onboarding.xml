    <string name="onboarding_body_weight_hint_kg">Weight in kilograms, like 70</string>
    <string name="onboarding_body_weight_hint_lb">Weight in pounds, like 155</string>

    <string name="onboarding_meals_title">When do you usually eat?</string>
    <string name="onboarding_meals_body">Today shows what's next from these. Tap a time to change it.</string>

