    <string name="onboarding_reason_loves_numbers">You said you like seeing the numbers.</string>
    <string name="onboarding_reason_some_are_fine">You said some numbers are fine, just not calories.</string>
    <string name="onboarding_reason_rather_not">You said you'd rather not see numbers.</string>
    <string name="onboarding_reason_gentler">You asked for a gentler start.</string>
    <string name="onboarding_reason_not_sure">You weren't sure yet, so you start without calories or amounts.</string>

