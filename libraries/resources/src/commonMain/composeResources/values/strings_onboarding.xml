<?xml version="1.0" encoding="utf-8"?>
<!--
  Onboarding: Welcome and the plan, two questions, the optional statement,
  the starting mode, the setup steps and the optional account step. Copy is design v3's
  (docs/design/v3/onboarding-*.png) word for word where it has it; the
  exceptions are marked. Preset labels are the shared ones in strings_modes.xml.
-->
<resources>
    <!-- Welcome. The design's "Friendly Tracking" is a placeholder for the app name. -->
    <string name="onboarding_welcome_title" translatable="false">Opson</string>
    <string name="onboarding_welcome_subtitle">Write down what you eat. See as many numbers as you want, or none.</string>
    <string name="onboarding_welcome_body">You can show, soften, save for later or hide every number, and change it whenever you like.</string>
    <string name="onboarding_welcome_not_medical">Opson is a food log, not medical advice. Food values are estimates.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_welcome_next">Next you'll add your birthday and sign in, so your log is saved to your account.</string>

    <!--
      The plan. The design lists "barcode scan, recipes" under Free; barcode is hidden in 0.1 and
      recipes are saved meals.
    -->
    <string name="onboarding_plan_free">Free</string>
    <string name="onboarding_plan_free_includes">Logging, saved meals and every mode</string>

    <!--
      Under the plan while release.betaNotice is on (owner, 2026-10-30): honest about the beta and
      that Pro isn't here. What the discount is, is the owner's call (docs/plans/onboarding-v4.md).
    -->
    <string name="onboarding_beta_title">You're early</string>
    <string name="onboarding_beta_body">Opson is in beta. Pro isn't here yet, and we're working on it. Everyone who joins during the beta gets a lifetime discount when it arrives.</string>

    <!-- Questions. Two and the statement since onboarding v2 (docs/plans/onboarding-v2.md). -->
    <string name="onboarding_progress">%1$d of %2$d</string>
    <string name="onboarding_progress_optional">%1$d of %2$d · Optional</string>
    <string name="onboarding_progress_description">Step %1$d of %2$d</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_pick_any">Pick any that fit.</string>

    <string name="onboarding_q_why">Why are you tracking?</string>
    <string name="onboarding_why_curious">Curious what I eat</string>
    <string name="onboarding_why_performance">Training or performance</string>
    <string name="onboarding_why_eating_enough">Eating enough</string>
    <string name="onboarding_why_eating_regularly">Eating regularly</string>
    <string name="onboarding_why_medical_need">A medical need</string>
    <string name="onboarding_why_changing_weight">Changing my weight</string>
    <string name="onboarding_why_working_with_provider">Working with a provider</string>

    <!--
      The numbers question. Opens by saying plainly that numbers don't suit everyone, so the
      gentler answers read as ordinary choices rather than admissions. Each answer names what it
      changes in words a person can check against themselves ("just not calories").
    -->
    <string name="onboarding_q_feel">How do numbers sit with you?</string>
    <string name="onboarding_feel_intro">Not everyone does well seeing calories, or thinking about them much.</string>
    <string name="onboarding_feel_love_them">I like seeing them</string>
    <string name="onboarding_feel_some_are_fine">Some are fine, just not calories</string>
    <string name="onboarding_feel_rather_not">I'd rather not see them</string>
    <string name="onboarding_feel_not_sure">I'm not sure yet</string>
    <string name="onboarding_feel_footnote">This only picks where you start. You can change any number later.</string>

    <!--
      The statement. A statement to agree with, never a question about a diagnosis.
      TODO(clinician): review the quote, the body and both answers before release.
      The design's body ends "and the answer stays on this phone", which is not true: the answer
      is saved with the rest of the settings, and settings sync to the person's account. The body
      says what a yes does: it keeps Full numbers off the starting list, the fasting timer off
      and watch activity out of the range (Settings.exerciseInRange, Fasts).
    -->
    <string name="onboarding_q_statement">Does this sound like you?</string>
    <string name="onboarding_statement_quote">“Numbers or tracking have been hard for me before.”</string>
    <string name="onboarding_statement_body">If you say yes, you get gentler starting points, and fasting and exercise adjustments stay off. We don't ask why.</string>
    <string name="onboarding_statement_yes">Yes, that's me</string>
    <string name="onboarding_statement_no">Not really</string>
    <string name="onboarding_talk_to_someone">Talk to someone</string>
    <string name="onboarding_see_starting_point">See my starting point</string>

    <!-- Recommendation -->
    <string name="onboarding_reco_kicker">Your starting point</string>
    <string name="onboarding_reco_see">You'll see</string>
    <string name="onboarding_reco_kept_out">Hidden</string>
    <string name="onboarding_reco_or">Or start with</string>
    <string name="onboarding_all_modes">All modes</string>
    <string name="onboarding_reco_change">Change it any time under More, then Display.</string>
    <string name="onboarding_start_with">Start with %1$s</string>
    <string name="onboarding_finishing">Setting things up…</string>

    <!-- The answer that picked the starting point (ModeRecommender.reason), under the mode's line. -->
