<?xml version="1.0" encoding="utf-8"?>
<!--
  The four modes (all numbers, macros with grams, macros only, no numbers) and End after a set
  time, shared by More › Display, onboarding's recommendation and Today. Copy is the design's word for word where it has it.
  Same rules as strings.xml: no backslash escapes, positional format specifiers.
-->
<resources>
    <!-- Presets, label and line (13.5a) -->
    <string name="modes_preset_full">All numbers</string>
    <string name="modes_preset_full_line">Calories, energy and macros in grams.</string>
    <string name="modes_preset_macros_grams">Macros with grams</string>
    <string name="modes_preset_macros_grams_line">Protein, carbs, fat and fiber in grams. No calories.</string>
    <string name="modes_preset_macros_only">Macros only</string>
    <string name="modes_preset_macros_only_line">Protein, carbs, fat and fiber as bars. No grams, no calories.</string>
    <string name="modes_preset_no_numbers">No numbers</string>
    <string name="modes_preset_no_numbers_line">Meals, timing and how they felt. No amounts anywhere.</string>

    <!-- End after a set time -->
    <string name="modes_end_after_title">End after a set time</string>
    <string name="modes_end_after_off">Switch to another mode on a set day</string>
    <!-- "2 weeks, then No numbers" -->
    <string name="modes_end_after_on">%1$s, then %2$s</string>
    <plurals name="modes_weeks">
        <item quantity="one">%1$d week</item>
        <item quantity="other">%1$d weeks</item>
    </plurals>
    <string name="modes_end_after_length">How long</string>
    <string name="modes_end_after_then">Then switch to</string>
    <string name="modes_end_after_ends">Switches on %1$s</string>

    <!-- Each number -->
    <string name="modes_each_number_title">Each number</string>
    <string name="modes_each_number_body">Set each number on its own</string>
    <string name="modes_back_modes">‹ Display</string>

    <!-- When Later opens -->
    <string name="modes_reveal_weekly_title">Once a week</string>
    <string name="modes_reveal_weekly_body">Totals open on the week view, on its last day</string>

    <!-- Today with calories as a word (any mode with calories set to Soft) -->
    <string name="modes_soft_label">Today</string>

    <!-- Today with calories on Later, before the reveal. The time follows the person's reveal time. -->
    <string name="modes_locked_title">Totals open at %1$s</string>
    <string name="modes_locked_counts">%1$s · %2$s</string>
    <plurals name="modes_foods">
        <item quantity="one">%1$d food</item>
        <item quantity="other">%1$d foods</item>
    </plurals>

    <!-- Today in No numbers (13.5d) -->
    <string name="modes_timeline_title">Meals today</string>
    <string name="modes_timeline_usual">~%1$s</string>
    <!-- What a screen reader says for a meal's circle: the meal, then when. -->
    <string name="modes_timeline_done_at_cd">%1$s, done at %2$s</string>
    <string name="modes_timeline_done_around_cd">%1$s, done, around %2$s</string>
    <string name="modes_timeline_open_cd">%1$s, not yet, usually around %2$s</string>

    <!-- Food detail in No numbers (13.5e) -->
    <string name="modes_hunger_question">How hungry were you? Optional</string>

    <!-- Today, when End after a set time runs out -->
    <string name="modes_timer_ended">Your time on %1$s is up. You're on %2$s now.</string>
    <string name="modes_timer_waiting">Your time on %1$s is up. Switch to %2$s when you're ready.</string>
    <string name="modes_timer_switch">Switch to %1$s</string>
</resources>
