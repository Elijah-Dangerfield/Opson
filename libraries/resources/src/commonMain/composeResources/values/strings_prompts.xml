<?xml version="1.0" encoding="utf-8"?>
<!--
  The prompts Today can show (:libraries:prompts:impl, docs/practices/prompts.md): one at most a
  session, never in an account's first days. Each offers one thing and takes no for an answer.
  Nothing here asks anyone to eat less or to log more. Same rules as strings.xml: no backslash
  escapes, positional format specifiers.
-->
<resources>
    <string name="prompt_not_now">Not now</string>

    <!-- Connect Apple Health or Health Connect (release.health), a sheet -->
    <string name="prompt_health_title_apple">Bring in Apple Health</string>
    <string name="prompt_health_title_connect">Bring in Health Connect</string>
    <string name="prompt_health_body_apple">Opson can show your workouts and the energy you use, read from Apple Health. Health data stays on this phone.</string>
    <string name="prompt_health_body_connect">Opson can show your workouts and the energy you use, read from Health Connect. Health data stays on this phone.</string>
    <string name="prompt_health_accept">Set it up</string>

    <!-- Meal reminders (release.reminders), a dialog -->
    <string name="prompt_reminders_title">A nudge at mealtimes?</string>
    <string name="prompt_reminders_body">Opson can remind you when a meal isn't logged by its usual time. You pick which meals, and it's easy to turn off.</string>
    <string name="prompt_reminders_accept">Choose reminders</string>

    <!-- The check-in (release.checkIn), a card in Today's list -->
    <string name="prompt_checkin_title">Try a check-in</string>
    <string name="prompt_checkin_body">A few taps on hunger, energy and mood. Only you see it.</string>
    <string name="prompt_checkin_accept">Check in</string>
</resources>
