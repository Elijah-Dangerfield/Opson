<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Progress photos unlock with the phone's own lock (BiometricPrompt with the device
         credential as fallback). A normal permission: granted at install, never prompted for. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
