<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The barcode scanner, and Photo estimate's "Take a photo". Asked for only when someone uses one. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: the app works without a camera, and search is always there. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>
        <!-- AndroidTextRecognizer uses the unbundled ML Kit model. This asks Play services to
             download it at install rather than on the first label read. Append to the value,
             comma separated, if another unbundled ML Kit model is added. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <!-- Photo estimate: the camera app writes the meal photo here through a one-off
             write grant, so no storage permission. The authority must match
             MealPhotoFileProvider.authority(). -->
        <provider
            android:name="com.opson.libraries.scanner.impl.MealPhotoFileProvider"
            android:authorities="${applicationId}.mealphoto"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/meal_photo_paths" />
        </provider>
    </application>
</manifest>
