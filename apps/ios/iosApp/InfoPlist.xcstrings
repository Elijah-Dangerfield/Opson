{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opson uses the camera to scan barcodes, photograph a food's label when you add or check it, photograph a meal when you ask for an estimate, and take progress photos if you choose to. Meal photos aren't saved. Progress photos stay on this iPhone."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opson uses Face ID to keep your progress photos private. Only you can open them."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opson reads your active energy, resting energy and workouts to show what you've burned today. These stay on your phone. If you ask it to, it also reads your weight, height, birth date and sex to fill in your profile and weight log, which sync with your Opson account."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opson only reads from Health. It doesn't write or change anything there."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opson listens when you tap the mic so you can say what you ate. Nothing is recorded or saved."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opson turns what you say into text to fill in your meal. Your iPhone does this on the device when it can. Otherwise Apple processes the audio, and Opson doesn't keep the recording."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
