# Copy this file to apps/server/.env and fill in real values.
# .env is gitignored. Never commit real credentials.
#
# In production, set these via your host's secret store instead of a file
# (e.g. `fly secrets set KEY=value`). OS env always wins over this file.

# ---- Database (optional) ----
#
# Postgres connection string. Leave unset to run in "limited mode" — the server
# still boots and serves /_health and /v1/example, but DB-backed routes are off.
#
# Local dev: run `docker compose -f apps/server/docker-compose.yml up -d` and use
#   postgresql://postgres:postgres@localhost:5432/postgres
#
# Supabase (production, IPv6 host):
#   postgresql://postgres:<password>@db.<projectref>.supabase.co:5432/postgres
# Supabase (local dev behind IPv4, use the Session Pooler):
#   postgresql://postgres.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# URL-encode special characters in the password — `$` becomes %24.
DATABASE_URL=

# Optional pool tuning. Defaults are fine for small instances.
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2
# How long a request waits for a free connection, and how long any one
# statement may run, before the server answers 503 busy. Migrations are exempt.
DATABASE_POOL_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ---- Supabase Auth (optional) ----
#
# Verifies the Supabase-issued JWTs the client sends on authenticated requests.
# Leave unset to disable auth: the server still boots, but the authenticated
# routes (/v1/me, /v1/sync, foods and barcode misses, photo, export) aren't
# mounted.
#
# The server fetches Supabase's public ES256 keys from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json at runtime. No shared secret.
SUPABASE_URL=

# Service-role JWT for Supabase Admin API calls (account deletion via
# DELETE /v1/me, display-name mirroring). Find it in the
# Supabase dashboard under Settings → API → service_role.
# TREAT AS A ROOT PASSWORD: full read/write on your project, bypasses RLS.
# Optional — endpoints that need it answer 503 NotConfigured when unset.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sign in with Apple token revocation (optional, needed for App Review) ----
#
# Apple asks apps with Sign in with Apple to revoke the person's Apple token when
# they delete their account. The server signs its requests to Apple with a Sign in
# with Apple key: developer.apple.com › Certificates, Identifiers & Profiles › Keys,
# a key with "Sign in with Apple" enabled for the app's App ID. Download the .p8.
# All three or none; unset, deletion still works and logs that it didn't revoke.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 file's contents. Treat as a password. On one line, write \n for newlines.
APPLE_PRIVATE_KEY=
# The app's bundle id. Defaults to com.opson.Opson.
APPLE_CLIENT_ID=

# ---- Moderation (optional) ----
#
# URL handed to banned clients in the 403 AccessDenied envelope so the app can
# offer an "appeal this" link. Unset → the block screen shows no appeal path.
APPEAL_URL=
#
# Device bans that survive a reinstall (README "Moderation"). Both are inert
# until set: contributions are then checked against the account and the app's
# install key only.
#
# Apple DeviceCheck: a key with DeviceCheck enabled (Certificates, Identifiers &
# Profiles › Keys; the Sign in with Apple key can carry it too). Uses APPLE_TEAM_ID.
APPLE_DEVICECHECK_KEY_ID=
# The .p8 file's contents. Treat as a password. On one line, write \n for newlines.
APPLE_DEVICECHECK_PRIVATE_KEY=
# production (TestFlight and App Store builds, the default) or development (debug builds).
APPLE_DEVICECHECK_ENVIRONMENT=
#
# Google Play Integrity: a service account JSON key from the Cloud project linked
# to the app in Play Console. Treat as a password.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# Defaults to com.opson.
PLAY_INTEGRITY_PACKAGE_NAME=
# true once Google has enrolled the app in device recall (beta).
PLAY_INTEGRITY_DEVICE_RECALL=

# ---- Outside food sources (optional, paid) ----
#
# A barcode that is not in our catalog goes to the outside sources that are
# switched on, best tier first. Open Food Facts is always on and needs nothing.
#
# Nutritionix (licensed, tier 3): set BOTH keys to switch it on; it is then
# asked before Open Food Facts. Keys come from the Nutritionix developer portal.
# Treat the key as a password.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
# Nutritionix's API terms limit storing their data. Leave this off (the
# default) unless your Nutritionix contract allows cached copies; off means
# every scan that reaches Nutritionix is a paid request and nothing is kept.
NUTRITIONIX_CACHE_RESULTS=false
# Name search over the full Open Food Facts table (off_foods). Off by default,
# so search answers as it did in 0.1. Turn it on only once off_foods is loaded
# and the app credits Open Food Facts wherever its foods appear.
FOOD_SEARCH_OFF_ENABLED=false
# Search answers kept in memory, and for how long. A repeated query (the
# same prefixes come up whenever anyone types) is answered without the
# database. 0 entries turns it off.
FOOD_SEARCH_CACHE_ENTRIES=256
FOOD_SEARCH_CACHE_SECONDS=300

# ---- Server AI (off in v1) ----
# Photo estimates, server label reads and the Builder second read call
# Anthropic only when AI_CALLS_ENABLED=true AND ANTHROPIC_API_KEY is set. v1
# runs with neither: labels are read on the phone and a person reviews the
# rest. A key on its own does nothing, so a stray key can't spend money. Off,
# POST /v1/describe/photo and POST /v1/foods/labels/parse answer 503 and the
# app falls back calmly. Treat the key as a password.
AI_CALLS_ENABLED=false
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5 at low effort.
ANTHROPIC_PHOTO_MODEL=
# Optional. The model that reads pack labels. Defaults to claude-fable-5-1 at
# high effort; a request it refuses outright is retried on ANTHROPIC_PHOTO_MODEL.
ANTHROPIC_LABEL_MODEL=
# Optional. The second, blind read of a Builder's label photo. Defaults to
# claude-haiku-5-5 at low effort.
ANTHROPIC_CHECK_MODEL=

# ---- Website waitlist ----
# Exact browser origins (comma-separated, scheme://host[:port]) allowed to call
# POST /v1/waitlist. Only that route uses this; the rest of the API keeps its
# own CORS policy. Unset: dev and local allow http://localhost:4321 and
# https://elijah-dangerfield.github.io, prod allows no browser origin.
WAITLIST_ALLOWED_ORIGINS=

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Root log level (TRACE, DEBUG, INFO, WARN, ERROR). Exposed stays at ERROR
# whatever this says: its warnings quote diary rows.
LOG_LEVEL=INFO

# ---- Remote-config admin (optional) ----
#
# Token for the config admin API under /v1/admin/config (and the hosted admin
# console at /admin). Independent from SUPABASE_SERVICE_ROLE_KEY so an operator
# or CI job can manage flags without holding admin rights at Supabase.
#
# Generate with `openssl rand -hex 32`. The admin routes aren't mounted when
# unset — remote config stays read-only.
ADMIN_API_TOKEN=

# Directory holding the prebuilt admin console bundle served at /admin.
# Defaults to apps/server/admin-web (the local `:apps:server:run` layout); the
# Docker image sets it to the baked-in bundle. Missing dir → /admin not served.
ADMIN_WEB_DIR=

# Slack-compatible incoming webhook that gets a one-line message on every
# config change made through the admin API. Unset → no notifications.
CONFIG_CHANGE_WEBHOOK_URL=

# ---- Observability (all optional) ----
#
# Sentry error reporting. Unset → no-op (the SDK never initialises).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=

# OpenTelemetry. Unset endpoint → traces/logs/metrics export to stdout (visible
# in your logs). Set it to ship OTLP/HTTP to a collector (Grafana, Honeycomb, …).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional headers, e.g. Authorization=Basic%20<base64>  (comma-separated, percent-encoded).
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=opson-server
# Tags on every span, log and metric. Default to SENTRY_ENVIRONMENT (or dev/prod
# from FLY_APP_NAME) and SENTRY_RELEASE.
OTEL_DEPLOYMENT_ENVIRONMENT=
OTEL_SERVICE_VERSION=
