# Copy this file to apps/server/.env and fill in real values.
# .env is gitignored. Never commit real credentials.
#
# In production, set these via your host's secret store instead of a file
# (e.g. `fly secrets set KEY=value`). OS env always wins over this file.

# ---- Database (optional) ----
#
# Postgres connection string. Leave unset to run in "limited mode" — the server
# still boots and serves /_health and /v1/example, but DB-backed routes are off.
#
# Local dev: run `docker compose -f apps/server/docker-compose.yml up -d` and use
#   postgresql://postgres:postgres@localhost:5432/postgres
#
# Supabase (production, IPv6 host):
#   postgresql://postgres:<password>@db.<projectref>.supabase.co:5432/postgres
# Supabase (local dev behind IPv4, use the Session Pooler):
#   postgresql://postgres.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# URL-encode special characters in the password — `$` becomes %24.
DATABASE_URL=

# Optional pool tuning. Defaults are fine for small instances.
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2

# ---- Supabase Auth (optional) ----
#
# Verifies the Supabase-issued JWTs the client sends on authenticated requests.
# Leave unset to disable auth — the server still boots, but /v1/me isn't mounted.
#
# The server fetches Supabase's public ES256 keys from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json at runtime. No shared secret.
SUPABASE_URL=

# Service-role JWT for Supabase Admin API calls (account deletion via
# DELETE /v1/me, display-name mirroring, anon-user sweeps). Find it in the
# Supabase dashboard under Settings → API → service_role.
# TREAT AS A ROOT PASSWORD: full read/write on your project, bypasses RLS.
# Optional — endpoints that need it answer 503 NotConfigured when unset.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Moderation (optional) ----
#
# URL handed to banned clients in the 403 AccessDenied envelope so the app can
# offer an "appeal this" link. Unset → the block screen shows no appeal path.
APPEAL_URL=

# ---- Outside food sources (optional, paid) ----
#
# A barcode that is not in our catalog goes to the outside sources that are
# switched on, best tier first. Open Food Facts is always on and needs nothing.
#
# Nutritionix (licensed, tier 3): set BOTH keys to switch it on; it is then
# asked before Open Food Facts. Keys come from the Nutritionix developer portal.
# Treat the key as a password.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
# Nutritionix's API terms limit storing their data. Leave this off (the
# default) unless your Nutritionix contract allows cached copies; off means
# every scan that reaches Nutritionix is a paid request and nothing is kept.
NUTRITIONIX_CACHE_RESULTS=false
# Name search over the full Open Food Facts table (off_foods). Off by default,
# so search answers as it did in 0.1. Turn it on only once off_foods is loaded
# and the app credits Open Food Facts wherever its foods appear.
FOOD_SEARCH_OFF_ENABLED=false

# ---- Photo estimates ----
# Anthropic API key for POST /v1/describe/photo. Unset, the route answers 503
# and the app says photo estimates aren't available. Treat it as a password.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5 at low effort.
ANTHROPIC_PHOTO_MODEL=

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO

# ---- Remote-config admin (optional) ----
#
# Token for the config admin API under /v1/admin/config (and the hosted admin
# console at /admin). Independent from SUPABASE_SERVICE_ROLE_KEY so an operator
# or CI job can manage flags without holding admin rights at Supabase.
#
# Generate with `openssl rand -hex 32`. The admin routes aren't mounted when
# unset — remote config stays read-only.
ADMIN_API_TOKEN=

# Directory holding the prebuilt admin console bundle served at /admin.
# Defaults to apps/server/admin-web (the local `:apps:server:run` layout); the
# Docker image sets it to the baked-in bundle. Missing dir → /admin not served.
ADMIN_WEB_DIR=

# Slack-compatible incoming webhook that gets a one-line message on every
# config change made through the admin API. Unset → no notifications.
CONFIG_CHANGE_WEBHOOK_URL=

# ---- Observability (all optional) ----
#
# Sentry error reporting. Unset → no-op (the SDK never initialises).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=

# OpenTelemetry. Unset endpoint → traces/logs/metrics export to stdout (visible
# in your logs). Set it to ship OTLP/HTTP to a collector (Grafana, Honeycomb, …).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional headers, e.g. Authorization=Basic%20<base64>  (comma-separated, percent-encoded).
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=opson-server
