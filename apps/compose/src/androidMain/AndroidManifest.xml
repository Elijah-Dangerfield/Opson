<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No backups: see res/xml/data_extraction_rules.xml. -->
    <application
        android:name=".OpsonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Opson">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboardHidden|smallestScreenSize|density|fontScale|locale">
            <!--
              configChanges: handle these changes inside Compose instead of
              letting Android recreate the Activity. Without this, the
              FloatingWindowNavigator instance passed to rememberNavController
              changes on recreation, which causes nav-compose to discard its
              saved back stack and pop the user to the start destination.
              All listed config changes are reactive in Compose (orientation,
              font scale, dark mode, density, locale), so the Activity does
              not need to recreate for them.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Custom-scheme deep links. Consumers:
              - `opson://auth/confirmed` — Supabase verify-email redirect.
              - `opson://login-callback` — browser OAuth return trip;
                NOT a nav route.
              MainActivity forwards every opson:// link to the DeepLinkBridge,
              as iOS does; App.kt hands the OAuth return to supabase-kt and
              routes the rest through the `deepLinks` on `screen<Route>`.

              App Links (https) sit beside it in their own autoVerify filter.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opson" />
            </intent-filter>

            <!--
              A shared recipe's link (release.recipes): https://www.opsontracker.com/r/<code>.
              Android opens the app for it once the site's /.well-known/assetlinks.json names
              this app's signing key (website/README.md, "Universal links and App Links");
              until then the link opens the recipe's web page, which offers Open in Opson.
              MainActivity forwards it to the DeepLinkBridge with the opson:// links.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.opsontracker.com" />
                <data android:host="opsontracker.com" />
                <data android:pathPrefix="/r/" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>