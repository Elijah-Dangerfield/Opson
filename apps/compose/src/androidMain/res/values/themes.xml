<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme with SplashScreen API support -->
    <style name="Theme.Opson" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Splash screen background -->
        <!-- API 31+ only. Older versions ignore it and show windowBackground, which is the same colour. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <!-- Status bar and nav bar colors -->
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <!-- Window background for after splash -->
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Dark status bar icons -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash background is Slate's light bg, the page colour the app opens on -->
    <color name="splash_background">#EEF1F6</color>
</resources>
